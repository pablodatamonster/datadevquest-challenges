# Copy this file to .env and fill it in. Never commit your .env file.

# Tableau (only needed for the live export)
TABLEAU_SERVER=https://prod-uk-a.online.tableau.com
TABLEAU_SITE=your-site-content-url
TABLEAU_PAT_NAME=your-token-name
TABLEAU_PAT_SECRET=your-token-secret
TABLEAU_API_VERSION=3.29

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-api-key
# Optional: any Claude model that can read images
CLAUDE_MODEL=claude-sonnet-5-5
